---
import MapBackground from './MapBackground.astro';
import MapDecorations from './MapDecorations.astro';
import MapRoute from './MapRoute.astro';
import MapMarkers from './MapMarkers.astro';

interface Destination {
  label: string;
  desc: string;
  href: string;
  x: string;
  y: string;
  cardSide: string;
  external: boolean;
}
interface Props {
  destinations: Destination[];
}
const { destinations } = Astro.props;
---

<div class="relative w-full h-screen overflow-hidden bg-parchment select-none" id="map-world">
  <MapBackground />
  <MapDecorations />
  <MapRoute />
  <MapMarkers destinations={destinations} />
</div>
