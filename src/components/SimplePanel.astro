<script>
  const panel = document.getElementById('sv-panel');
  const compassRose = document.getElementById('sv-compass-rose') as SVGSVGElement | null;

  if (panel && compassRose) {
    let current = 0;
    let target  = 0;
    let running = false;

    function tick() {
      current += (target - current) * 0.07;
      compassRose.style.transform = `rotate(${current}deg)`;
      if (Math.abs(target - current) > 0.08) {
        requestAnimationFrame(tick);
      } else {
        running = false;
      }
    }

    function start() {
      if (!running) { running = true; requestAnimationFrame(tick); }
    }

    panel.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = panel.getBoundingClientRect();
      target = Math.atan2(
        e.clientY - (rect.top + rect.height / 2),
        e.clientX - (rect.left + rect.width / 2)
      ) * (180 / Math.PI) + 90;
      start();
    });

    panel.addEventListener('mouseleave', () => { target = 0; start(); });
  }
</script>
