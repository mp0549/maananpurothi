---
import Footer from '@/components/Footer.astro';
import SimplePanel from './SimplePanel.astro';
import SimpleArchipelago from './SimpleArchipelago.astro';

interface Destination {
  label: string;
  desc: string;
  href: string;
  x: string;
  y: string;
  cardSide: string;
  external: boolean;
}
interface Props {
  destinations: Destination[];
}
const { destinations } = Astro.props;
---

<div class="sv-shell">
  <SimplePanel />
  <SimpleArchipelago destinations={destinations} />
</div>

<Footer />

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;1,9..40,400&display=swap');

  .sv-shell {
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .sv-shell {
      flex-direction: column;
      height: auto;
      overflow: visible;
    }
  }
</style>
