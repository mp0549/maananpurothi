---
/**
 * GardenNote.astro — Individual herbarium note card.
 * Torn journal page with pushpin, excerpt, tag stamps, and expand/collapse dispatch.
 *
 * Fed by the `greenhouse` collection — one markdown file per note in
 * src/data/greenhouse/ (see src/content.config.ts).
 *
 * Excerpt and summary copy go through <ProseText>, so a note's frontmatter takes
 * the same inline markup as about.json ([text](url), [text|definition], word(url)).
 * Summaries additionally split on blank lines into separate paragraphs.
 */
import ProseText from '@/components/ProseText.astro';

interface Props {
  note: {
    title: string;
    date: string;
    excerpt: string;
    summary?: string;
    slug: string;
    tags: string[];
  };
  index: number;
}

const { note, index } = Astro.props;

function tagColor(tag: string): string {
  if (tag === 'Thinking') return '#6B1515';
  if (tag === 'Writing')  return '#8B6914';
  if (tag === 'AI')       return '#2C4A2C';
  if (tag === 'Craft')    return '#3C2A1A';
  if (tag === 'Reading')  return '#8B6914';
  if (tag === 'Cooking')  return '#6B1515';
  if (tag === 'Outdoors') return '#2C4A2C';
  if (['Theory', 'Systems'].includes(tag)) return '#5a4a38';
  return '#3C2A1A';
}

// 6 distinct torn-edge clip-path variations
const clipPaths = [
  `polygon(0% 0%, 100% 0%, 100% 94%, 97% 97%, 94% 95%, 91% 98%, 88% 95%, 85% 98%, 82% 95%, 79% 97%, 76% 94%, 73% 97%, 70% 95%, 67% 98%, 64% 95%, 61% 97%, 58% 94%, 55% 97%, 52% 95%, 49% 98%, 46% 95%, 43% 97%, 40% 94%, 37% 97%, 34% 95%, 31% 98%, 28% 95%, 25% 97%, 22% 94%, 19% 97%, 16% 95%, 13% 98%, 10% 95%, 7% 97%, 4% 94%, 0% 97%)`,
  `polygon(0% 0%, 100% 0%, 100% 95%, 97% 98%, 94% 96%, 91% 99%, 88% 96%, 85% 99%, 82% 96%, 79% 98%, 76% 95%, 73% 98%, 70% 96%, 67% 99%, 64% 96%, 61% 98%, 58% 95%, 55% 98%, 52% 96%, 49% 99%, 46% 96%, 43% 98%, 40% 95%, 37% 98%, 34% 96%, 31% 99%, 28% 96%, 25% 98%, 22% 95%, 19% 98%, 16% 96%, 13% 99%, 10% 96%, 7% 98%, 4% 95%, 0% 98%)`,
  `polygon(0% 0%, 100% 0%, 100% 93%, 97% 96%, 94% 94%, 91% 97%, 88% 94%, 85% 97%, 82% 94%, 79% 96%, 76% 93%, 73% 96%, 70% 94%, 67% 97%, 64% 94%, 61% 96%, 58% 93%, 55% 96%, 52% 94%, 49% 97%, 46% 94%, 43% 96%, 40% 93%, 37% 96%, 34% 94%, 31% 97%, 28% 94%, 25% 96%, 22% 93%, 19% 96%, 16% 94%, 13% 97%, 10% 94%, 7% 96%, 4% 93%, 0% 96%)`,
  `polygon(0% 0%, 100% 0%, 100% 94%, 98% 97%, 95% 95%, 92% 98%, 89% 96%, 86% 99%, 83% 96%, 80% 98%, 77% 95%, 74% 97%, 71% 95%, 68% 98%, 65% 95%, 62% 97%, 59% 94%, 56% 97%, 53% 95%, 50% 98%, 47% 95%, 44% 97%, 41% 94%, 38% 97%, 35% 95%, 32% 98%, 29% 95%, 26% 97%, 23% 94%, 20% 97%, 17% 95%, 14% 98%, 11% 95%, 8% 97%, 5% 94%, 0% 97%)`,
  `polygon(0% 0%, 100% 0%, 100% 95%, 97% 99%, 94% 96%, 91% 99%, 88% 96%, 85% 99%, 82% 96%, 79% 98%, 76% 95%, 73% 98%, 70% 96%, 67% 99%, 64% 96%, 61% 98%, 58% 95%, 55% 99%, 52% 96%, 49% 98%, 46% 95%, 43% 98%, 40% 95%, 37% 99%, 34% 96%, 31% 98%, 28% 95%, 25% 98%, 22% 96%, 19% 99%, 16% 96%, 13% 98%, 10% 95%, 7% 98%, 4% 96%, 0% 99%)`,
  `polygon(0% 0%, 100% 0%, 100% 93%, 97% 96%, 94% 94%, 91% 97%, 88% 95%, 85% 98%, 82% 95%, 79% 97%, 76% 94%, 73% 97%, 70% 95%, 67% 97%, 64% 94%, 61% 97%, 58% 95%, 55% 98%, 52% 94%, 49% 97%, 46% 95%, 43% 98%, 40% 95%, 37% 97%, 34% 95%, 31% 98%, 28% 94%, 25% 97%, 22% 95%, 19% 97%, 16% 95%, 13% 98%, 10% 95%, 7% 97%, 4% 94%, 0% 97%)`,
];

// Botanical marginalia SVGs (ink-colored, faint)
const botanicalSVGs = [
  `<svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M22 40 C22 40 22 24 22 10 M22 24 C22 24 13 19 9 12 M22 30 C22 30 31 26 34 18" stroke="#1C1208" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  `<svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="16" cy="24" r="4.5" stroke="#1C1208" stroke-width="1"/><circle cx="27" cy="22" r="3.8" stroke="#1C1208" stroke-width="1"/><circle cx="21" cy="32" r="4.2" stroke="#1C1208" stroke-width="1"/><path d="M16 19.5 C16 19.5 18 13 22 10 M27 18.2 C27 18.2 29 12 26 8" stroke="#1C1208" stroke-width="0.9" fill="none" stroke-linecap="round"/></svg>`,
  `<svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M24 40 C24 40 26 28 30 19 C34 10 31 4 26 7 C21 10 22 22 24 40Z" stroke="#1C1208" stroke-width="1" fill="none" stroke-linecap="round"/><path d="M24 33 C24 33 17 30 13 25 C9 20 10 14 15 17 C20 20 24 33 24 33Z" stroke="#1C1208" stroke-width="1" fill="none" stroke-linecap="round"/></svg>`,
];

// Blank line = paragraph break, same convention as the drafts in src/data.
const summaryParagraphs = (note.summary ?? '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

const clipPath = clipPaths[index % 6];
const showBotanical = index % 2 === 1;
const botanicalSVG = botanicalSVGs[Math.floor(index / 2) % 3];
---

<div class="garden-note-wrapper" data-idx={index} data-tags={note.tags.join(',')}>
  <!-- Physical pushpin -->
  <div class="garden-pin" aria-hidden="true"></div>

  <!-- Torn journal page card -->
  <div class="garden-note" style={`clip-path: ${clipPath};`}>

    <!-- Date line with leaf glyph -->
    <p class="garden-note-date">❧ {note.date}</p>

    <!-- Title -->
    <h2 class="garden-note-title">{note.title}</h2>

    <!-- Gold rule -->
    <div class="garden-note-rule" aria-hidden="true"></div>

    <!-- Excerpt -->
    <p class="garden-note-excerpt"><ProseText text={note.excerpt} /></p>

    <!-- Specimen stamp tags -->
    <div class="flex flex-wrap gap-1.5 mt-4">
      {note.tags.map((tag) => (
        <span
          class="specimen-stamp"
          style={`color: ${tagColor(tag)}; border-color: ${tagColor(tag)};`}
        >{tag}</span>
      ))}
    </div>

    <!-- READ DISPATCH button — expands the summary inline -->
    <button class="dispatch-btn" type="button" aria-expanded="false">
      READ DISPATCH &rarr;
    </button>

    <!-- Expanded content (hidden by default) -->
    <div class="garden-expanded" aria-hidden="true">

      <!-- Small botanical divider -->
      <div class="garden-expanded-divider" aria-hidden="true">
        <svg width="120" height="22" viewBox="0 0 120 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 11 Q30 9 60 11 Q90 13 115 11" stroke="#8B6914" stroke-width="1" fill="none" stroke-linecap="round"/>
          <path d="M32 11 Q30 7 27 5 M32 11 Q34 6 37 4" stroke="#8B6914" stroke-width="0.8" fill="none" stroke-linecap="round"/>
          <path d="M60 11 Q58 7 55 5 M60 11 Q62 6 65 4" stroke="#8B6914" stroke-width="0.8" fill="none" stroke-linecap="round"/>
          <path d="M88 11 Q86 7 83 5 M88 11 Q90 6 93 4" stroke="#8B6914" stroke-width="0.8" fill="none" stroke-linecap="round"/>
        </svg>
      </div>

      <p class="garden-summary-label">SUMMARY</p>
      {summaryParagraphs.map((p) => (
        <p class="garden-summary-text"><ProseText text={p} /></p>
      ))}

      <div class="garden-expand-actions">
        <a href={`/garden/${note.slug}`} class="see-full-dispatch">SEE FULL DISPATCH &rarr;</a>
        <button class="close-dispatch-btn" type="button">CLOSE &uarr;</button>
      </div>
    </div>

    <!-- Botanical marginalia on every other card -->
    {showBotanical && (
      <div class="botanical-marginalia" aria-hidden="true" set:html={botanicalSVG} />
    )}
  </div>
</div>
