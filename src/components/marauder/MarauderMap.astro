/* Ink spatter clusters — {x, y, red?, dots: [dx, dy, r, o][]}. */
const spatter = [
  { x: 985, y: 92, red: true, dots: [[0, 0, 2.2, 0.4], [11, 6, 1.2, 0.32], [-8, 9, 1.5, 0.28], [18, -4, 0.9, 0.22], [6, 16, 1.1, 0.18], [-15, 3, 0.8, 0.16]] },
  { x: 1372, y: 702, dots: [[0, 0, 2.6, 0.42], [-10, 8, 1.4, 0.3], [12, 4, 1.1, 0.26], [4, -12, 0.9, 0.2], [-6, -8, 0.8, 0.15]] },
  { x: 250, y: 690, dots: [[0, 0, 1.9, 0.35], [9, 7, 1.2, 0.26], [-7, 11, 1, 0.2], [15, -2, 0.8, 0.15]] },
] as { x: number; y: number; red?: boolean; dots: number[][] }[];

/* Soft age stains — irregular low-opacity blobs. */
const stains = [
  { x: 560, y: 655, rx: 44, ry: 34, rot: -14, o: 0.045 },
  { x: 1185, y: 178, rx: 36, ry: 28, rot: 22, o: 0.04 },
