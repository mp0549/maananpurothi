<style>
  /* ── container / parchment ─────────────────────────────────────────── */
  .marauder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--color-parchment);
  }
  .marauder-tex {
    position: absolute;
    inset: 0;
    background-image: url('/textures/parchment_texture1.jpg');
    background-size: 520px 520px;
    background-repeat: repeat;
    mix-blend-mode: multiply;
    opacity: 0.26;
    filter: sepia(0.25);
    pointer-events: none;
    z-index: 1;
  }
  .marauder-stage {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .marauder-pan {
    will-change: transform;
    height: 100%;
    display: flex;
    align-items: center;
  }

  /* fit mode: entire map visible, centred */
  .marauder-stage.fit .marauder-pan { width: 100%; justify-content: center; }
  .marauder-stage.fit svg { max-width: 100%; max-height: 100%; width: auto; height: auto; }

  /* pan mode: height fills, width overflows */
  .marauder-stage.pan { justify-content: flex-start; touch-action: none; cursor: grab; }
  .marauder-stage.pan.grabbing { cursor: grabbing; }
  .marauder-stage.pan svg { height: 100%; width: auto; max-width: none; max-height: 100%; }

  svg { display: block; user-select: none; }

  /* ── ink stroke language ───────────────────────────────────────────── */
  svg path,
  svg line,
  svg polyline,
  svg circle,
  svg ellipse {
    fill: none;
    stroke: #1c1208;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .ink1, .ink1 * { stroke-width: 2.2; opacity: 0.85; }
  .ink2, .ink2 * { stroke-width: 1.3; opacity: 0.62; }
  .ink3, .ink3 * { stroke-width: 1; opacity: 0.4; }
  .dot { fill: rgba(28, 18, 8, 0.75); stroke: none; }
  .dot.faint { fill: rgba(28, 18, 8, 0.4); }

  /* ghost architecture — background noise, deliberately faint */
  .ghost { opacity: 0.38; }

  /* red ink — second pen, used sparingly (warnings, seals, the X) */
  .red, .red * { stroke: #8b1a1a; }
  .dot.red { fill: rgba(139, 26, 26, 0.7); stroke: none; }
  .red-fill { fill: rgba(139, 26, 26, 0.68); stroke: none; }
  .red-spatter .spatter-dot { fill: #8b1a1a; }

  /* mess: blots, stains, spatter */
  .blot { fill: rgba(28, 18, 8, 0.14); stroke: rgba(28, 18, 8, 0.25); stroke-width: 0.8; }
  .blot.dark { fill: rgba(28, 18, 8, 0.12); stroke: none; }
  .stain { fill: rgba(28, 18, 8, 1); stroke: none; }
  .spatter-dot { fill: rgba(28, 18, 8, 1); stroke: none; }

  /* dotted outdoor trails */
  .trail path {
    stroke-width: 2.4;
    opacity: 0.55;
    stroke-dasharray: 2.5 13;
  }

  /* structural details */
  .swing { stroke-dasharray: 3 4; }
  .rug { stroke-dasharray: 4 5; }
  .smoke { stroke-width: 1.2; opacity: 0.45; stroke-dasharray: 3 6; }
  .spark, .spark * { stroke-width: 1.4; opacity: 0.72; }
  .leaf { fill: rgba(28, 18, 8, 0.12); stroke: #1c1208; stroke-width: 1; opacity: 0.6; }
  .pawprint { fill: rgba(28, 18, 8, 0.5); stroke: none; }

  /* compass north tip — the single gold accent */
  .compass-n { fill: var(--color-gold); stroke: var(--color-gold); stroke-width: 1; opacity: 0.9; }
  .compass-letter { font-family: 'Cinzel', serif; font-size: 15px; fill: var(--color-ink); opacity: 0.8; stroke: none; }

  /* ── text styles ───────────────────────────────────────────────────── */
  .title-text {
    font-family: 'Cinzel Decorative', serif;
    font-weight: 700;
    font-size: 30px;
    letter-spacing: 3px;
    fill: var(--color-ink);
    stroke: none;
    transition: fill 180ms ease;
  }
  .title-ribbon path { fill: rgba(245, 236, 215, 0.75); }

  /* clickable title — subtle affordance on hover/focus */
  #map-home-link { cursor: pointer; }
  #map-home-link:hover .title-text,
  #map-home-link:focus-visible .title-text {
    fill: var(--color-gold);
  }
  #map-home-link:focus-visible {
    outline: none;
  }
  #map-home-link:focus-visible .title-hit {
    stroke: var(--color-gold);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }
  .flavor {
    font-family: 'IM Fell English', serif;
    font-style: italic;
    font-size: 17px;
    fill: var(--color-ink-muted);
    stroke: none;
    opacity: 0.85;
  }
  .flavor.small { font-size: 14px; }
  .microlabel {
    font-family: 'IM Fell English', serif;
    font-style: italic;
    font-size: 12px;
    fill: var(--color-ink-muted);
    stroke: none;
    opacity: 0.75;
  }
  .microlabel.tiny { font-size: 10.5px; opacity: 0.65; }

  /* ── location interaction ──────────────────────────────────────────── */
  .loc-link { cursor: pointer; outline: none; }
  .loc-hit { fill: transparent; stroke: none; }
  .loc { pointer-events: auto; }

  .loc-name {
    font-family: 'Cinzel', serif;
    font-weight: 600;
    font-variant-caps: small-caps;
    font-size: 19px;
    letter-spacing: 1.2px;
    fill: var(--color-ink);
    stroke: none;
  }
  .loc-banner path {
    fill: rgba(245, 236, 215, 0.92);
    stroke: #1c1208;
    stroke-width: 1.5;
    opacity: 0.9;
    transition: stroke 0.25s ease;
  }
  .loc-banner { transition: transform 0.2s ease; transform: translateY(0); }

  .loc-card { fill: rgba(243, 233, 205, 0.985); stroke: rgba(139, 105, 20, 0.55); stroke-width: 1; }
  .loc-desc-text {
    font-family: 'IM Fell English', serif;
    font-style: italic;
    font-size: 15.5px;
    fill: #41321b;
    stroke: none;
  }
  .loc-desc {
    opacity: 0;
    transform: translateY(-5px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  .loc-ring {
    fill: none;
    stroke: var(--color-gold);
    stroke-width: 1.6;
    stroke-dasharray: 5 5;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  /* building strokes warm toward gold; banner lifts; desc unfurls */
  .loc .bldg { transition: stroke 0.28s ease; }
  .loc:hover .bldg,
  .loc-link:focus-visible .bldg { stroke: var(--color-gold); }
  .loc:hover .loc-banner path,
  .loc-link:focus-visible .loc-banner path { stroke: var(--color-gold); }
  .loc:hover .loc-banner,
  .loc-link:focus-visible .loc-banner { transform: translateY(-3px); }
  .loc:hover .loc-desc,
  .loc-link:focus-visible .loc-desc { opacity: 1; transform: translateY(0); }
  .loc-link:focus-visible .loc-ring { opacity: 0.9; }

  /* ── edge hints ────────────────────────────────────────────────────── */
  .edge-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 74px;
    z-index: 3;
    display: none;
    align-items: center;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.4s ease;
  }
  .edge-left {
    left: 0;
    justify-content: flex-start;
    padding-left: 8px;
    background: linear-gradient(to right, rgba(245, 236, 215, 0.9), rgba(245, 236, 215, 0));
  }
  .edge-right {
    right: 0;
    justify-content: flex-end;
    padding-right: 8px;
    background: linear-gradient(to left, rgba(245, 236, 215, 0.9), rgba(245, 236, 215, 0));
  }
  .marauder.can-pan .edge-fade.active { display: flex; }
  .marauder.panned .edge-fade { opacity: 0; }
  .chevron path { fill: none; stroke: var(--color-gold); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .chevron { opacity: 0.75; }
  .edge-left .chevron { animation: nudge-left 1.6s ease-in-out infinite; }
  .edge-right .chevron { animation: nudge-right 1.6s ease-in-out infinite; }
  @keyframes nudge-left { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(-5px); } }
  @keyframes nudge-right { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(5px); } }

  /* ── screen-reader-only nav ────────────────────────────────────────── */
  .sr-nav {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .sr-nav a:focus {
    position: fixed;
    top: 8px;
    left: 8px;
    width: auto;
    height: auto;
    clip: auto;
    background: var(--color-parchment-light);
    padding: 6px 12px;
    z-index: 50;
    border: 1px solid var(--color-gold);
  }

  /* ── Phase-2 ceremony draw-on (additive; classes toggled by MapCeremony) ──
     is-undrawn hides the map; is-drawing animates it in. The controller tags
     every element with --dd (delay), --ddur (draw duration) and, for fade
     elements, --cer-op (their natural opacity) + the `cer-fade` class.
     Dash-drawables = path/line with pathLength that are NOT cer-fade (the
     controller withholds cer-fade from exactly those); everything else fades.
     End state removes all these classes/vars → the SVG behaves identically. */
  .marauder.is-undrawn [pathLength]:not(.cer-fade) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .marauder.is-undrawn .cer-fade {
    opacity: 0;
  }
  .marauder.is-drawing [pathLength]:not(.cer-fade) {
    animation: map-draw var(--ddur, 650ms) ease-out var(--dd, 0ms) both;
  }
  .marauder.is-drawing .cer-fade {
    animation: cer-fade var(--cer-fade-dur, 400ms) ease var(--dd, 0ms) both;
  }
  @keyframes map-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes cer-fade {
    from { opacity: 0; }
    to { opacity: var(--cer-op, 1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .loc-banner, .loc-desc, .loc .bldg, .loc-ring, .loc-banner path { transition: none; }
    .chevron { animation: none; }

    /* If a ceremony ever slips through (it should not — index keeps its fast
       path under reduced motion), never leave the map hidden. */
    .marauder.is-undrawn [pathLength]:not(.cer-fade) { stroke-dasharray: none; stroke-dashoffset: 0; }
    .marauder.is-undrawn .cer-fade { opacity: var(--cer-op, 1); }
    .marauder.is-drawing [pathLength]:not(.cer-fade),
    .marauder.is-drawing .cer-fade { animation: none; }
  }
</style>

<script>
  const MAP_ASPECT = 1600 / 1000;
  const FIT_THRESHOLD = 1.2; // container aspect >= this → fit whole map; below → pan

  function initMarauder(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('[data-stage]');
    const pan = root.querySelector<HTMLElement>('[data-pan]');
    const edgeLeft = root.querySelector<HTMLElement>('[data-edge="left"]');
    const edgeRight = root.querySelector<HTMLElement>('[data-edge="right"]');
    if (!stage || !pan) return;

    let panEnabled = false;
    let tx = 0;
    let minX = 0;
    const maxX = 0;
    let hasPanned = false;
    let dragging = false;
    let startX = 0;
    let startTx = 0;
    let rafId = 0;
    let pendingX = 0;
    let initialised = false;

    function apply() {
      pan!.style.transform = `translate3d(${tx}px,0,0)`;
    }

    function updateEdges() {
      if (!panEnabled || hasPanned) {
        edgeLeft?.classList.remove('active');
        edgeRight?.classList.remove('active');
        return;
      }
      const canLeft = tx < maxX - 1; // content hidden to the left
      const canRight = tx > minX + 1; // content hidden to the right
      edgeLeft?.classList.toggle('active', canLeft);
      edgeRight?.classList.toggle('active', canRight);
    }

    function clamp(v: number) {
      return Math.max(minX, Math.min(maxX, v));
    }

    function layout() {
      const w = stage!.clientWidth;
      const h = stage!.clientHeight;
      if (!w || !h) return;
      const containerAspect = w / h;

      if (containerAspect >= FIT_THRESHOLD) {
        panEnabled = false;
        stage!.classList.add('fit');
        stage!.classList.remove('pan');
        root.classList.remove('can-pan', 'panned');
        tx = 0;
        pan!.style.transform = '';
        updateEdges();
        return;
      }

      // pan mode
      stage!.classList.remove('fit');
      stage!.classList.add('pan');
      root.classList.add('can-pan');
      panEnabled = true;
      const svgW = h * MAP_ASPECT;
      minX = Math.min(0, w - svgW);
      if (!initialised) {
        tx = minX / 2; // start centred
        initialised = true;
      }
      tx = clamp(tx);
      apply();
      updateEdges();
    }

    function onMove(clientX: number) {
      pendingX = clamp(startTx + (clientX - startX));
      if (!rafId) {
        rafId = requestAnimationFrame(() => {
          rafId = 0;
          tx = pendingX;
          apply();
          updateEdges();
        });
      }
    }

    stage.addEventListener('pointerdown', (e: PointerEvent) => {
      if (!panEnabled) return;
      dragging = true;
      startX = e.clientX;
      startTx = tx;
      stage.classList.add('grabbing');
      try { stage.setPointerCapture(e.pointerId); } catch (_) {}
    });

    stage.addEventListener('pointermove', (e: PointerEvent) => {
      if (!dragging) return;
      if (!hasPanned && Math.abs(e.clientX - startX) > 8) {
        hasPanned = true;
        root.classList.add('panned');
      }
      onMove(e.clientX);
    });

    function endDrag(e: PointerEvent) {
      if (!dragging) return;
      dragging = false;
      stage!.classList.remove('grabbing');
      try { stage!.releasePointerCapture(e.pointerId); } catch (_) {}
    }
    stage.addEventListener('pointerup', endDrag);
    stage.addEventListener('pointercancel', endDrag);

    // Prevent link navigation when a drag moved the map.
    let moved = 0;
    stage.addEventListener('pointerdown', () => { moved = 0; });
    stage.addEventListener('pointermove', (e: PointerEvent) => { if (dragging) moved = Math.abs(e.clientX - startX); });
    root.querySelectorAll<HTMLAnchorElement>('a.loc-link').forEach((a) => {
      a.addEventListener('click', (e) => {
        if (moved > 8) {
          e.preventDefault();
          e.stopPropagation();
        }
      });
    });

    const ro = new ResizeObserver(() => layout());
    ro.observe(stage);
    window.addEventListener('resize', layout);
    layout();
  }

  document.querySelectorAll<HTMLElement>('[data-marauder]').forEach(initMarauder);
</script>
