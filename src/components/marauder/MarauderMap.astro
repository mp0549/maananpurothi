---
/**
 * MarauderMap.astro — The Archives centerpiece (v2: aerial floor-plan).
 * Hand-inked, Marauder's-Map-inspired plan view of a castle complex on parchment.
 * Monochrome ink (#1C1208); gold (#8B6914) only on the compass N tip + hover/focus.
 * Deliberately messy: ink blots, spatter, age stains, wobbly double-stroked walls.
 *
 * Layer contract (ids matter — Phase-2 animation hooks):
 *   #layer-paths · #layer-buildings · #layer-labels · #layer-flourishes · #layer-footprints
 * Every drawn stroke carries pathLength="1" for uniform draw-on animation.
 * data-draw="N" buckets set choreography order (1 corridors · 2 buildings · 3 labels · 4 flourishes).
 */
import mapData from '../../data/map.json';

type Loc = { id: string; name: string; desc: string; href: string; external: boolean };
const locs = mapData as Loc[];
const byId = (id: string) => locs.find((l) => l.id === id)!;

/** Greedy word-wrap for SVG tspan descriptions. */
function wrap(text: string, max = 26): string[] {
  const words = text.split(' ');
  const lines: string[] = [];
  let cur = '';
  for (const w of words) {
    if ((cur + ' ' + w).trim().length > max) {
      if (cur) lines.push(cur);
      cur = w;
    } else {
      cur = (cur + ' ' + w).trim();
    }
  }
  if (cur) lines.push(cur);
  return lines;
}

const owlery = byId('owlery');
const library = byId('codex');
const common = byId('about');
const garden = byId('garden');
const workshop = byId('now');
const portfolio = byId('portfolio');
const lab = byId('lab');

const linkAttrs = (l: Loc) =>
  l.external ? { href: l.href, target: '_blank', rel: 'noopener noreferrer' } : { href: l.href };

const corners = [
  { t: 'translate(70,142)' },
  { t: 'translate(1530,142) scale(-1,1)' },
  { t: 'translate(70,930) scale(1,-1)' },
  { t: 'translate(1530,930) scale(-1,-1)' },
];

/* Footprints walking the west corridor toward the Common Room (decorative). */
const trailWest = [
  { x: 676, y: 514, r: 88, o: 0.5 },
  { x: 640, y: 520, r: 93, o: 0.46 },
  { x: 604, y: 514, r: 86, o: 0.42 },
  { x: 568, y: 522, r: 95, o: 0.38 },
  { x: 500, y: 516, r: 90, o: 0.32 },
  { x: 464, y: 521, r: 92, o: 0.26 },
  { x: 428, y: 515, r: 88, o: 0.2 },
];
/* Footprints heading up the northeast corridor toward the Library. */
const trailNE = [
  { x: 874, y: 412, r: 232, o: 0.46 },
  { x: 904, y: 395, r: 228, o: 0.4 },
  { x: 934, y: 378, r: 234, o: 0.34 },
  { x: 964, y: 362, r: 229, o: 0.27 },
  { x: 994, y: 347, r: 232, o: 0.2 },
