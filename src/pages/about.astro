---
/**
 * about.astro — The Archives
 * Two-column: ornate portrait frame left, pinned notes right.
 * Warm library room feel — NOT a portfolio page.
 */
import Layout from '@/layouts/Layout.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import ProseText from '@/components/ProseText.astro';
import aboutData from '@/data/about.json';

const { caption, sections } = aboutData;
const whoIAm       = sections.find((s) => s.id === "who-i-am")!;
const whatICare    = sections.find((s) => s.id === "what-i-care-about")!;
const howIGot      = sections.find((s) => s.id === "how-i-got-here")!;
const whereImGoing = sections.find((s) => s.id === "where-im-going")!;
const marginalia   = sections.find((s) => s.id === "marginalia")!;
---

<Layout
  title="Biographical Notes — The Archives"
  description="Who I am, what I care about, and where I am going."
  variant="interior"
  pageTitle="Biographical Notes"
>

  <!-- Page texture layer -->
  <div class="relative min-h-screen">
    <div
      class="fixed inset-0 pointer-events-none"
      style="background-image: url('/textures/parchment_texture1.jpg'); background-size: 420px 420px; mix-blend-mode: multiply; opacity: 0.2; filter: sepia(0.2); z-index: 0;"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 md:px-12 py-16">

      <!-- ── Two-column layout ──────────────────────────────────────── -->
      <div class="grid md:grid-cols-[260px_1fr] gap-12 items-start">

        <!-- Left: Portrait + annotation -->
        <aside class="md:sticky md:top-24 flex flex-col items-center gap-6">

          <!-- Portrait frame -->
          <div class="portrait-frame w-full aspect-[3/4] flex items-center justify-center">
            <!-- Replace with <img> when you have a photo -->
            <div class="flex flex-col items-center gap-2 opacity-60">
              <span
                class="font-display text-5xl text-ink-muted"
                style="line-height: 1;"
              >MP</span>
              <div style="width: 30px; height: 1px; background: var(--color-gold-pale);"></div>
              <span class="font-decorative text-xs tracking-widest text-gold-pale uppercase" style="font-size: 0.5rem;">Portrait</span>
            </div>
          </div>

          <!-- Small caption -->
          <div class="text-center space-y-1">
            <p class="font-decorative text-xs text-gold uppercase tracking-widest" style="font-size: 0.55rem; letter-spacing: 0.2em;">
              {caption.roles}
            </p>
            <p class="font-body italic text-xs text-ink-muted">
              [{caption.location}]
            </p>
          </div>

          <!-- Decorative ornament -->
          <span class="ornament text-lg" aria-hidden="true">❧</span>
        </aside>

        <!-- Right: Pinned notes -->
        <div class="space-y-8">

          <!-- Note 1: Who I Am -->
          <section class="pinned-note scroll-reveal">
            <h2 class="font-display text-lg text-ink mb-3">{whoIAm.heading}</h2>
            <div class="text-ink-muted leading-relaxed space-y-3 font-body">
              {(whoIAm.paragraphs ?? []).map((p) => <p><ProseText text={p} /></p>)}
            </div>
          </section>

          <SectionDivider glyph="✦" />

          <!-- Note 2: What I Care About -->
          <section class="pinned-note scroll-reveal">
            <h2 class="font-display text-lg text-ink mb-3">{whatICare.heading}</h2>
            <div class="space-y-3 font-body">
              {(whatICare.items ?? []).map(({ glyph, text }) => (
                <div class="flex gap-3 items-baseline">
                  <span class="text-gold font-decorative text-xs shrink-0 mt-0.5">{glyph}</span>
                  <p class="text-ink-muted leading-relaxed"><ProseText text={text} /></p>
                </div>
              ))}
            </div>
          </section>

          <SectionDivider glyph="⁕" />

          <!-- Note 3: How I Got Here -->
          <section class="pinned-note scroll-reveal">
            <h2 class="font-display text-lg text-ink mb-3">{howIGot.heading}</h2>
            <div class="text-ink-muted leading-relaxed space-y-3 font-body">
              {(howIGot.paragraphs ?? []).map((p) => <p><ProseText text={p} /></p>)}
            </div>
          </section>

          <SectionDivider glyph="❧" />

          <!-- Note 4: Where I'm Going -->
          <section class="pinned-note scroll-reveal">
            <h2 class="font-display text-lg text-ink mb-3">{whereImGoing.heading}</h2>
            <div class="text-ink-muted leading-relaxed space-y-3 font-body">
              {(whereImGoing.paragraphs ?? []).map((p) => <p><ProseText text={p} /></p>)}
              {whereImGoing.quote && (
                <p class="font-fell italic text-ink" style="font-size: 1rem;">
                  "{whereImGoing.quote}"
                </p>
              )}
            </div>
          </section>

          <SectionDivider glyph="✦" />

          <!-- Note 5: Marginalia — the non-professional half, kept deliberately
               lighter than the notes above. The scribbled asides use --font-hand
               so they read as margin notes rather than more body copy. -->
          <section class="pinned-note scroll-reveal">
            <h2 class="font-display text-lg text-ink mb-3">{marginalia.heading}</h2>
            <div class="text-ink-muted leading-relaxed space-y-3 font-body">
              {(marginalia.paragraphs ?? []).map((p) => <p><ProseText text={p} /></p>)}
            </div>
            {(marginalia.notes ?? []).length > 0 && (
              <ul class="margin-notes">
                {(marginalia.notes ?? []).map((n) => (
                  <li><ProseText text={n} /></li>
                ))}
              </ul>
            )}
          </section>

        </div>
      </div>

    </div>
  </div>

</Layout>
