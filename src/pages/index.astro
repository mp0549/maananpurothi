---
/**
 * index.astro — the landing page: the simple-first hero (PlainArchives).
 *
 * The interactive map now lives at its OWN route, /map (split out 2026-07-30).
 * This page is just the hero: its "I solemnly swear" CTA navigates to the map,
 * carrying `?ceremony=1` so the parchment-unfold intro plays on arrival (unless
 * reduced motion, which goes straight to /map). "Mischief Managed." / the map
 * title on /map navigate back here.
 *
 * variant="map" keeps the chrome clean (no interior nav/footer); a pre-paint
 * script sets state 'simple' and unlocks body scroll for the tall hero.
 */
import Layout from '@/layouts/Layout.astro';
import CursorFootprints from '@/components/marauder/CursorFootprints.astro';
import PlainArchives from '@/components/marauder/PlainArchives.astro';
---

<!-- Simple-first: always open on the hero. Unlock scroll before first paint
     (the map variant body starts locked). Record the hero as the current "hub"
     so interior pages' back-link points here ("Back to the Menu"). -->
<script is:inline>
  (function () {
    document.documentElement.setAttribute('data-archives-state', 'simple');
    document.body.classList.remove('h-screen', 'overflow-hidden');
    document.body.style.minHeight = '100vh';
    // Default the back-link to the menu: clear any stale hub. It's only set to
    // 'map' at click-time when a destination is opened FROM the map.
    try {
      sessionStorage.removeItem('archives-hub');
    } catch (_) {}
  })();
</script>

<Layout
  title="The Archives"
  description="Personal website- A record of work and thought"
  variant="map"
>
  <PlainArchives />

  <!-- Footprints trail the cursor on the hero too (fixed overlay). -->
  <CursorFootprints />
</Layout>

<style>
  /* The hero scrolls; the map variant body starts locked, so unlock it here. */
  :global(html[data-archives-state='simple'] body) {
    height: auto !important;
    min-height: 100vh;
    overflow: visible !important;
  }
</style>
