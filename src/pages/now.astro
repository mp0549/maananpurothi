---
/**
 * now.astro — The Observatory
 * Placeholder while the living field report gets written.
 * Prior section scaffold (Building / Reading / Thinking) archived in now.drafts.md.
 */
import Layout from '@/layouts/Layout.astro';
import nowData from '@/data/now.json';

const { lastUpdated, status, intro, note } = nowData;
---

<Layout
  title="The Workshop — The Archives"
  description="What I am currently building, reading, and thinking about — updated periodically."
  variant="interior"
  pageTitle="The Workshop"
>
  <div class="max-w-prose mx-auto px-6 py-14 space-y-10">

    <!-- Intro -->
    <div class="scroll-reveal">
      <p class="section-label text-xs mb-2">The Observatory</p>
      <p class="font-fell italic text-ink" style="font-size: 1.1rem; line-height: 1.6;">
        {intro}
      </p>
      <span class="heading-rule max-w-[6rem] mt-4"></span>
    </div>

    <!-- In-progress panel -->
    <div class="workshop-placeholder scroll-reveal">
      <div class="workshop-wax-stamp" aria-hidden="true">
        <span set:html={status.replace(' ', '<br/>')} />
      </div>

      <p class="workshop-placeholder-text">{note}</p>
    </div>

    <!-- Closing ornament -->
    <div class="text-center py-4 scroll-reveal">
      <span class="ornament text-2xl" aria-hidden="true">✦</span>
      <p class="text-ink-muted text-xs font-display tracking-widest mt-4">
        Last Updated: {lastUpdated}
      </p>
    </div>

  </div>
</Layout>

<style>
  .workshop-placeholder {
    position: relative;
    border: 1px solid rgba(139, 105, 20, 0.25);
    background: rgba(234, 217, 184, 0.18);
    box-shadow: inset 0 0 0 3px rgba(245, 236, 215, 0.5);
    padding: 2rem 1.75rem;
    padding-right: 5.5rem;
    overflow: hidden;
  }

  .workshop-placeholder-text {
    font-family: 'Crimson Text', serif;
    font-style: italic;
    font-size: 1rem;
    line-height: 1.8;
    color: #7C6A4E;
    max-width: 34ch;
  }

  .workshop-wax-stamp {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: radial-gradient(circle, #8B3a3a 0%, #6B1515 70%, #4a0f0f 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(107, 21, 21, 0.35), inset 0 1px 3px rgba(255, 255, 255, 0.1);
    opacity: 0.82;
  }

  .workshop-wax-stamp span {
    font-family: 'Cinzel', serif;
    font-size: 0.38rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(245, 236, 215, 0.9);
    text-align: center;
    line-height: 1.4;
  }

  @media (max-width: 480px) {
    .workshop-placeholder { padding-right: 1.75rem; }
    .workshop-wax-stamp { position: static; margin-bottom: 1rem; }
    .workshop-placeholder-text { max-width: none; }
  }
</style>
